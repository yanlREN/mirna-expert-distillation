{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DEEPSEEK_CORE_AUDIT_SCHEMA_V1_PROVIDER",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "confidence", "recommended_relation", "reason"],
  "properties": {
    "label": {
      "type": "string",
      "enum": ["CORRECT", "WRONG_ENTITY", "WRONG_RELATION", "WRONG_DIRECTION", "INSUFFICIENT_EVIDENCE", "UNCERTAIN"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "recommended_relation": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1}
  }
}
