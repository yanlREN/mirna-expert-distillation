{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DEEPSEEK_CORE_AUDIT_SCHEMA_V1_FINAL",
  "type": "object",
  "additionalProperties": false,
  "required": ["relation_id", "model", "label", "confidence", "recommended_relation", "reason", "raw_response"],
  "properties": {
    "relation_id": {"type": "string", "minLength": 1},
    "model": {"const": "deepseek"},
    "label": {
      "type": "string",
      "enum": ["CORRECT", "WRONG_ENTITY", "WRONG_RELATION", "WRONG_DIRECTION", "INSUFFICIENT_EVIDENCE", "UNCERTAIN"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "recommended_relation": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "raw_response": {"type": "string", "minLength": 2}
  }
}
